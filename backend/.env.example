MARKSURVEY_ENVIRONMENT=development
MARKSURVEY_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]
MARKSURVEY_MONGODB_URI=mongodb://localhost:27017
MARKSURVEY_MONGODB_DATABASE=marksurvey
MARKSURVEY_AUTH_SECRET=replace-with-at-least-32-random-characters
MARKSURVEY_SESSION_TTL_HOURS=24
MARKSURVEY_COOKIE_SECURE=false
MARKSURVEY_EMAIL_BACKEND=console
MARKSURVEY_SMTP_HOST=
MARKSURVEY_SMTP_PORT=587
MARKSURVEY_SMTP_USERNAME=
MARKSURVEY_SMTP_PASSWORD=
MARKSURVEY_SMTP_FROM=no-reply@marksurvey.local
MARKSURVEY_SMTP_TLS=starttls
MARKSURVEY_EMAIL_CODE_TTL_MINUTES=10
MARKSURVEY_EMAIL_CODE_RESEND_SECONDS=60
MARKSURVEY_EMAIL_CODE_MAX_ATTEMPTS=5
MARKSURVEY_CAPTCHA_TTL_SECONDS=120
MARKSURVEY_CAPTCHA_TOKEN_TTL_SECONDS=300
MARKSURVEY_CAPTCHA_TOLERANCE_PX=5
